OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
# Public web search for Step 1A. Without this key, only explicitly supplied
# public listing/company URLs are fetched and all other research stays unanswered.
TAVILY_API_KEY=

# Shared durable storage. On Vercel a connected Blob store injects
# BLOB_STORE_ID and delivers the OIDC token as a per-request header, so no
# static token is needed there. Locally, `vercel env pull` provides
# BLOB_STORE_ID plus a short-lived VERCEL_OIDC_TOKEN.
BLOB_STORE_ID=
# Static fallback for code running outside Vercel or without OIDC.
BLOB_READ_WRITE_TOKEN=
