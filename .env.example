OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
# Public web search for Step 1A. Without this key, only explicitly supplied
# public listing/company URLs are fetched and all other research stays unanswered.
TAVILY_API_KEY=

# Shared durable storage on Vercel. Connected Blob stores use OIDC
# automatically (VERCEL_OIDC_TOKEN + BLOB_STORE_ID). Use this static token only
# outside Vercel or when OIDC is unavailable.
BLOB_READ_WRITE_TOKEN=
